# Copy to .env. Never commit .env.

# NEAR network for the registry: testnet | mainnet
NEAR_NETWORK=testnet
# Registry contract: byline.testnet (testnet) / byline.near (mainnet)
REGISTRY_CONTRACT_ID=byline.testnet

# 1Click partner JWT (optional; without it 1Click adds 25 bps and the Explorer API is unavailable)
ONECLICK_JWT=

# Intents Explorer API JWT (same partner portal; needed for referral-filtered swap history)
EXPLORER_JWT=


# Optional: NEAR AI Cloud key for the "explain my trades" step
NEARAI_API_KEY=

# Gasless onboarding relayer (only if you run one: `npm run relayer` or the Vercel function in apps/web/api).
# A function-call access key on the registry account, limited to `register_signed`. Never commit it.
RELAYER_NETWORK=testnet
RELAYER_TESTNET_KEY=
RELAYER_MAINNET_KEY=
# Proof-of-work difficulty asked of each new registration (leading zero bits; 0 = off). Default 20.
RELAYER_POW_BITS=
# Shared per-IP rate limit (Upstash Redis REST). Required for the hosted relayer on mainnet.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Where `createAgentByline` / `npm run agent -- --create` send signed registrations.
# Empty = the hosted relayer (testnet.by-line.xyz / www.by-line.xyz); local: http://localhost:8787/register
BYLINE_RELAYER_URL=

# Private NEAR RPC (server-side only: indexer, relayer, demo agent, MCP). Full URLs, e.g. dRPC endpoints
# with your key. Empty = the public FastNear RPC. Never expose these through VITE_ variables.
NEAR_RPC_MAINNET=
NEAR_RPC_TESTNET=
