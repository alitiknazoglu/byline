{
  "name": "@by-line/sdk",
  "version": "0.2.0",
  "description": "Give your AI agent a byline on NEAR: credit every swap, payment and transaction to the agent and its builder.",
  "license": "MIT",
  "author": "Ali Tıknazoğlu",
  "homepage": "https://www.by-line.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitiknazoglu/byline.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/alitiknazoglu/byline/issues"
  },
  "keywords": [
    "near",
    "ai-agents",
    "agents",
    "attribution",
    "near-intents",
    "1click",
    "nep-171",
    "nep-413",
    "byline"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "default": "./dist/relay.js"
    },
    "./chain": {
      "types": "./dist/chain.d.ts",
      "default": "./dist/chain.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "near-kit": "0.20.2",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
